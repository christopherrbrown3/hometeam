# Browser-safe Supabase values only. Never add a database password, service-role key,
# secret key, connection string, or VAPID private key to a VITE_ variable.
#
# For local Supabase, run `npx --yes supabase@2.110.0 status -o env` after
# starting the stack, then map its API_URL and browser-safe ANON_KEY/publishable
# key to the variables below. See supabase/migrations/README.md.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
